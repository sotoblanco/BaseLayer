# LLM provider (optional). Coding and spreadsheet lessons work with these empty.
#
# Free to start:
#   gemini   — get a key at https://aistudio.google.com/app/apikey
#   groq     — free tier at https://console.groq.com/keys
#   ollama   — local, no key (ollama pull llama3.2)
#   lmstudio — local, no key
# Also: openai | openrouter | custom
#
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=
# LLM_API_BASE=
#
# Aliases: OPENAI_API_KEY, OPENAI_BASE_URL, GEMINI_API_KEY
# GEMINI_API_KEY=

# JWT Secret Key for Authentication
# REQUIRED. The server refuses to start if this is missing or is the old placeholder.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database configuration (defaults to sqlite:///database.db)
# DATABASE_URL=sqlite:///database.db

# Backend configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Test configuration
# The base URL for the API during tests
BASE_URL=http://localhost:8000

# Optional: Directory for course content (defaults to ./courses)
# COURSES_DIR=/absolute/path/to/courses

# Modal Deployment Settings (Optional)
MODAL_APP_NAME=code-app
MODAL_VOLUME_NAME=code-app-volume
MODAL_SECRET_NAME=code-app-secrets

# Modal credentials. Only needed when /run executes through the remote Modal
# sandbox (docker compose sets EXECUTION_ENV=modal). Obtain them with: modal token new
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Code execution backend (optional; docker compose sets EXECUTION_ENV=modal itself).
#   modal — run student code in the remote Modal sandbox (same as production)
#   docker — run student code via `docker run sandbox-runner` on this host (default
#            when unset; used by ./dev.sh, which runs the backend on the host)
# EXECUTION_ENV=modal

# Local-only name prompt (no password). Never enable in production.
ALLOW_LOCAL_WELCOME=true

# Google OAuth (Sign in with Google)
# Same client ID as frontend VITE_GOOGLE_CLIENT_ID. Required on the backend to verify ID tokens.
GOOGLE_CLIENT_ID=

# Frontend Google client ID (same value as GOOGLE_CLIENT_ID above). Used by the
# Docker Compose frontend (docker-compose.yml interpolates VITE_GOOGLE_CLIENT_ID).
# Leave unset to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Google Sheets Integration (Optional)
# GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account.json
